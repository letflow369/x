{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letflow369.github.io/x/content/schema/substance-dossier-v1.schema.json",
  "title": "Let Flow 369 — Substance Dossier v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "template",
    "slug",
    "document",
    "page"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "template": {
      "const": "substance-dossier-v1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "document": {
      "type": "object",
      "required": [
        "lang",
        "title",
        "description",
        "canonical",
        "styles",
        "structuredData"
      ],
      "properties": {
        "lang": {
          "type": "string"
        },
        "bodyId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "themeColor": {
          "type": "string"
        },
        "canonical": {
          "type": "string",
          "format": "uri"
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "headScripts": {
          "type": "array"
        },
        "structuredData": {
          "type": "object"
        },
        "headTailStyles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "skipLink",
        "breadcrumbs",
        "article",
        "backToTop",
        "postScripts"
      ],
      "properties": {
        "breadcrumbs": {
          "type": "array",
          "minItems": 2
        },
        "article": {
          "type": "object",
          "required": [
            "classes",
            "hero",
            "toc",
            "sections",
            "footer"
          ],
          "properties": {
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "classes"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "classes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ariaLabelledBy": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "innerClasses": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "innerHtml": {
                    "type": "string"
                  },
                  "blocks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/editorialBlock"
                    }
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "innerHtml"
                    ],
                    "not": {
                      "required": [
                        "blocks"
                      ]
                    }
                  },
                  {
                    "required": [
                      "blocks"
                    ],
                    "not": {
                      "required": [
                        "innerHtml"
                      ]
                    }
                  }
                ]
              }
            },
            "preLayoutSections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "classes"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "classes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ariaLabelledBy": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "innerClasses": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "innerHtml": {
                    "type": "string"
                  },
                  "blocks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/editorialBlock"
                    }
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "innerHtml"
                    ],
                    "not": {
                      "required": [
                        "blocks"
                      ]
                    }
                  },
                  {
                    "required": [
                      "blocks"
                    ],
                    "not": {
                      "required": [
                        "innerHtml"
                      ]
                    }
                  }
                ]
              }
            },
            "layout": {
              "type": "object",
              "properties": {
                "outerClasses": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "classes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "contentClasses": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "toc": {
              "type": "object",
              "properties": {
                "classes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "title": {
                  "type": "string"
                },
                "items": {
                  "type": "array"
                },
                "innerHtml": {
                  "type": "string"
                },
                "ariaLabel": {
                  "type": "string"
                }
              }
            },
            "typedBlocks": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "pilot": {
                  "type": "boolean"
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "editorialBlock": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "section-heading",
            "summary-grid",
            "evidence-key",
            "card-grid",
            "timeline",
            "flow",
            "callout",
            "table",
            "clinical-study",
            "details-list",
            "filter-bar",
            "study-grid",
            "review-date",
            "paragraph"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
